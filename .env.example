# Postgres
POSTGRES_USER=fairness_user
POSTGRES_PASSWORD=fairness_pass
POSTGRES_DB=fairness_db
DATABASE_URL=postgresql+psycopg2://fairness_user:fairness_pass@postgres:5432/fairness_db

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Anthropic API (for LangGraph agent nodes)
ANTHROPIC_API_KEY=your_api_key_here

# App
ENV=development
LOG_LEVEL=INFO
